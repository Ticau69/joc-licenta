<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
<ui:Button name="CardButton" style="background-color: rgba(255, 255, 255, 0.05); border-radius: 8px; border-width: 1px; border-color: rgba(255, 255, 255, 0.1); padding: 10px; margin-bottom: 5px; flex-direction: row; justify-content: space-between; align-items: center;">
        
        <ui:VisualElement picking-mode="Ignore">
            <ui:Label text="Nume Angajat" name="EmployeeNameLabel" style="color: white; font-size: 16px; -unity-font-style: bold; margin-bottom: 2px;" />
            <ui:Label text="Funcție" name="EmployeeRoleLabel" style="color: rgb(180, 180, 180); font-size: 12px;" />
        </ui:VisualElement>

        <ui:Label text="😐" name="EmployeeMoodEmoji" style="font-size: 24px;" picking-mode="Ignore" />
        
    </ui:Button>
</ui:UXML>