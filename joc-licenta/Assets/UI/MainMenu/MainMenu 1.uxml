<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/mainmenuUSS.uss?fileID=7433441132597879392&amp;guid=fb829a9d754addd4b8a06c7673ef5cfe&amp;type=3#mainmenuUSS"/>
    <ui:VisualElement name="BackGround" style="flex-grow: 1; color: rgb(0, 38, 255); width: 100%; background-color: rgba(28, 128, 172, 0.55); -unity-font-definition: url(&quot;project://database/Assets/UI/Jersey15-Regular.ttf?fileID=12800000&amp;guid=bf7a342c4db27da4d81c12715905f253&amp;type=3#Jersey15-Regular&quot;);">
        <ui:VisualElement name="Buttons" style="flex-grow: 1; background-color: rgb(24, 21, 21); width: 40%; left: 0%; border-right-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); padding: 30px; justify-content: center; align-self: center;">
            <ui:Image name="Logo" source="project://database/Assets/UI/MainMenu/GameLogo.png?fileID=21300000&amp;guid=94f53133cdd28a448b2cfec2d4fcbce5&amp;type=3#GameLogo" style="width: 100%; height: 25%; margin-bottom: 20px;"/>
            <ui:Label name="ErrorLabel" text="Eroare de autentificare" style="color: rgb(255, 0, 0); -unity-text-align: middle-center; display: none; margin-bottom: 10px; white-space: normal;"/>
            <ui:VisualElement name="LoginPanel" style="flex-direction: column; align-items: stretch; height: 479px; display: flex;">
                <ui:TextField name="LoginEmailInput" label="Email:" style="color: white; margin-bottom: 10px;"/>
                <ui:TextField name="LoginPasswordInput" label="Parola:" password="true" style="color: white; margin-bottom: 20px;"/>
                <ui:Button text="LOGIN" name="LoginButton" class="buttons" style="align-self: center; margin-bottom: 10px; font-size: 30px; width: 60%; height: auto; -unity-text-align: middle-center; top: 38%; color: rgb(255, 255, 255); background-color: rgb(12, 163, 188); -unity-font-style: bold; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); align-items: auto; transition-duration: 0.2s; transition-timing-function: ease-in-out;"/>
                <ui:Button text="QUIT" name="QuitButton" class="buttons" style="align-self: center; width: 60%; height: auto; margin-bottom: 20px; top: 40%; background-color: rgb(12, 163, 188); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); color: rgb(255, 255, 255); -unity-font-style: bold; transition-duration: 0.2s; transition-timing-function: ease-in-out;"/>
                <ui:Label text="Nu ai cont?" style="color: rgb(150, 150, 150); -unity-text-align: middle-center; margin-top: 10px; font-size: 14px; white-space: nowrap; top: 40%; position: absolute; align-self: center;"/>
                <ui:Button text="Înregistrează-te aici" name="GoToRegisterBtn" style="background-color: transparent; border-width: 0; color: rgb(100, 180, 255); -unity-font-style: bold; font-size: 15px; align-self: center; bottom: auto; position: absolute; top: 47%; transition-duration: 0.2s; transition-timing-function: ease-in-out;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RegisterPanel" style="flex-direction: column; align-items: stretch; display: none; height: 75%;">
                <ui:TextField name="RegisterNameInput" label="Numele tău:" style="color: white; margin-bottom: 10px;"/>
                <ui:TextField name="RegisterEmailInput" label="Email:" style="color: white; margin-bottom: 10px;"/>
                <ui:TextField name="RegisterPasswordInput" label="Parola:" password="true" style="color: white; margin-bottom: 20px;"/>
                <ui:Button text="REGISTER" name="RegisterButton" class="buttons" style="align-self: center; margin-bottom: 20px; font-size: 30px; width: 60%; height: auto; -unity-text-align: middle-center; top: 39%; background-color: rgb(12, 163, 188); border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); color: rgb(255, 255, 255); -unity-font-style: bold; transition-duration: 0.2s; transition-timing-function: ease-in-out;"/>
                <ui:Label text="Ai deja cont?" style="color: rgb(150, 150, 150); -unity-text-align: middle-center; margin-top: 10px; font-size: 14px; top: 45%; position: absolute; align-self: center;"/>
                <ui:Button text="Înapoi la Login" name="GoToLoginBtn" style="background-color: transparent; border-width: 0; color: rgb(100, 180, 255); -unity-font-style: bold; font-size: 15px; align-self: center; top: 1%; transition-duration: 0.2s; transition-timing-function: ease-in-out;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
