<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UI.V2/DarkDropdown.uss?fileID=7433441132597879392&amp;guid=f72771c131193c047aab8b716da43ef0&amp;type=3#DarkDropdown"/>
    <ui:VisualElement name="BackgroundOverlay" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0); justify-content: center; align-items: center; display: flex; top: -62px; -unity-font-definition: url(&quot;project://database/Assets/UI/Jersey15-Regular.ttf?fileID=12800000&amp;guid=bf7a342c4db27da4d81c12715905f253&amp;type=3#Jersey15-Regular&quot;);">
        <ui:VisualElement name="EmployeeManagementContainer" style="flex-direction: row; width: 80%; height: 72%; background-color: rgba(30, 30, 35, 0.98); border-radius: 16px; border-width: 2px; border-color: rgba(255, 255, 255, 0.1); display: flex;">
            <ui:VisualElement name="LeftPanel" style="width: 40%; border-right-width: 2px; border-right-color: rgba(255, 255, 255, 0.1); padding: 15px;">
                <ui:Label text="ANGAJAȚII MEI" style="color: white; font-size: 24px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 15px;"/>
                <ui:ScrollView name="EmployeeListScrollView" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.3); border-radius: 8px; padding: 5px;"/>
                <ui:Button name="HireNewButton" text="+ ANGAJEAZĂ NOU" style="height: 50px; background-color: rgb(66, 133, 244); color: white; -unity-font-style: bold; font-size: 16px; border-radius: 8px; border-width: 0; margin-top: 15px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RightPanel" style="width: 60%; padding: 25px; justify-content: flex-start;">
                <ui:Label name="SelectedEmployeeName" text="Selectează un angajat din stânga" style="color: white; font-size: 26px; -unity-font-style: bold; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.2); padding-bottom: 15px; margin-bottom: 20px;"/>
                <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.2); border-radius: 10px; padding: 15px; margin-bottom: 20px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 15px; align-items: center;">
                        <ui:Label text="Funcție:" style="color: rgb(180, 180, 180); font-size: 18px;"/>
                        <ui:DropdownField name="RoleDropdown" choices="Fără Rol, Casier, Manipulant Marfă, Curățător" style="width: 193px; font-size: 14px; -unity-font-style: bold; border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; margin-left: 4px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <ui:Label text="Nivel &amp; Experiență:" style="color: rgb(180, 180, 180); font-size: 18px;"/>
                        <CircularProgress name="EmployeeLevelProgress" progress="0" thickness="6" center-text="1" text-size="16" track-color="rgba(255,255,255,0.1)" progress-color="rgb(100, 180, 255)" style="width: 45px; height: 45px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.1); padding-top: 15px; margin-top: 5px;">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 5px;">
                            <ui:Label text="SALARIU ZILNIC:" style="color: rgb(220, 220, 220); font-size: 18px; -unity-font-style: bold;"/>
                            <ui:Label name="EmployeeSalaryText" text="150 RON" style="color: rgb(255, 80, 80); font-size: 20px; -unity-font-style: bold;"/>
                        </ui:VisualElement>
                        <ui:SliderInt name="SalarySlider" low-value="50" high-value="1000" value="150" style="margin-top: 10px;"/>
                        <ui:Label name="ExpectedSalaryText" text="Salariu așteptat: 150 RON" style="color: rgb(150, 150, 150); font-size: 12px; -unity-text-align: right; margin-top: 5px;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; justify-content: flex-end;">
                    <ui:Button name="FireButton" text="CONCEDIAZĂ" style="height: 50px; background-color: rgb(200, 50, 50); color: white; font-size: 14px; border-radius: 8px; border-width: 0; bottom: -10px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="ClosePanelButton" text="X" style="position: absolute; right: -15px; top: -15px; width: 45px; height: 45px; background-color: rgb(220, 50, 50); color: white; border-radius: 25px; border-width: 2px; border-color: white; -unity-font-style: bold; font-size: 22px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
