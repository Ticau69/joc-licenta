<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xmlns:ui="UnityEngine.UIElements" 
         editor-extension-mode="False">

    <!-- 
        InventoryRowTemplate
        Layout: [BarStoc] | [NumeProdus + BaraProgres] | [Stoc] | [Profit] | [VIEW]
    -->
    <ui:VisualElement name="InventoryRow" 
        style="flex-direction: row; align-items: center; 
               padding: 8px 10px; margin-bottom: 2px;
               background-color: rgba(255,255,255,0.04);
               border-radius: 6px;
               min-height: 52px;">

        <!-- ── 1. Indicator stoc (bara verticală colorată) ───────────────── -->
        <ui:VisualElement name="StockIndicatorBar"
            style="width: 4px; min-width: 4px; height: 36px;
                   border-radius: 2px;
                   background-color: rgb(76, 175, 80);
                   margin-right: 10px; flex-shrink: 0;"/>

        <!-- ── 2. Coloana centrală: Nume + bara progres depozit ───────────── -->
        <ui:VisualElement name="ProductInfo"
            style="flex-grow: 1; flex-direction: column; 
                   justify-content: center; margin-right: 8px;">

            <ui:Label name="ProductNameLabel" text="Nume Produs"
                style="color: rgb(240, 240, 240); font-size: 13px;
                       -unity-font-style: bold; margin-bottom: 4px;"/>

            <!-- Bara de progres stoc depozit -->
            <ui:VisualElement name="StockBarContainer"
                style="width: 100%; height: 5px; 
                       background-color: rgba(255,255,255,0.1);
                       border-radius: 3px; overflow: hidden;">
                <ui:VisualElement name="StockBarFill"
                    style="width: 50%; height: 100%;
                           background-color: rgb(76, 175, 80);
                           border-radius: 3px;
                           transition-property: width;
                           transition-duration: 0.3s;"/>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- ── 3. Stoc (cantitate) ────────────────────────────────────────── -->
        <ui:VisualElement name="StockColumn"
            style="width: 48px; align-items: center; 
                   flex-direction: column; margin-right: 8px; flex-shrink: 0;">
            <ui:Label name="StockAmountLabel" text="0"
                style="color: rgb(200, 200, 200); font-size: 13px;
                       -unity-font-style: bold;"/>
            <ui:Label text="buc"
                style="color: rgb(120, 120, 120); font-size: 10px;"/>
        </ui:VisualElement>

        <!-- ── 4. Profit per unitate ──────────────────────────────────────── -->
        <ui:VisualElement name="ProfitColumn"
            style="width: 60px; align-items: center;
                   flex-direction: column; margin-right: 8px; flex-shrink: 0;">
            <ui:Label name="ProfitLabel" text="+0 RON"
                style="color: rgb(76, 175, 80); font-size: 12px;
                       -unity-font-style: bold;"/>
            <ui:Label text="profit"
                style="color: rgb(120, 120, 120); font-size: 10px;"/>
        </ui:VisualElement>

        <!-- ── 5. Buton VIEW ─────────────────────────────────────────────── -->
        <ui:Button name="ViewButton" text="VIEW"
            style="width: 52px; height: 32px; flex-shrink: 0;
                   background-color: rgba(255,255,255,0.08);
                   border-radius: 6px; border-width: 1px;
                   border-color: rgba(255,255,255,0.15);
                   color: rgb(200, 200, 200); font-size: 11px;
                   -unity-font-style: bold;"/>

    </ui:VisualElement>
</ui:UXML>
