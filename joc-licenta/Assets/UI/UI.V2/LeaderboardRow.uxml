<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="LeaderboardRowContainer" style="flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 12px; margin-bottom: 5px; background-color: rgba(255, 255, 255, 0.04); border-radius: 6px; border-left-width: 3px; border-left-color: rgba(255, 255, 255, 0.15);">
        <ui:VisualElement style="flex-direction: row; align-items: center;">
            <ui:Label text="#1" name="RankLabel" style="color: rgb(222, 255, 154); -unity-font-style: bold; font-size: 13px; margin-right: 10px; width: 25px;" />
            <ui:Label text="Nume Jucător" name="NameLabel" style="color: white; font-size: 13px; -unity-font-style: bold;" />
        </ui:VisualElement>
        <ui:Label text="0 pct" name="ScoreLabel" style="color: rgb(255, 215, 0); -unity-font-style: bold; font-size: 13px;" />
    </ui:VisualElement>
</ui:UXML>