<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="SupplierCard"
        style="padding: 14px; margin-bottom: 6px;
               background-color: rgba(255,255,255,0.06);
               border-top-left-radius: 10px; border-top-right-radius: 10px;
               border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
               border-left-width: 3px; border-left-color: rgb(255,215,80);">

        <!-- Rând 1: Nume + Status -->
        <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:Label name="SupplierNameLabel" text="Furnizor"
                style="flex-grow: 1; color: white; font-size: 15px;
                       -unity-font-style: bold;"/>
            <ui:Label name="RelationshipStatusLabel" text="Neutru"
                style="font-size: 12px; color: rgb(255,215,80);
                       background-color: rgba(255,215,80,0.1);
                       padding-left: 8px; padding-right: 8px;
                       padding-top: 3px; padding-bottom: 3px;
                       border-top-left-radius: 10px; border-top-right-radius: 10px;
                       border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;"/>
        </ui:VisualElement>

        <!-- Bara relatie -->
        <ui:VisualElement name="RelationBarBg"
            style="width: 100%; height: 3px;
                   background-color: rgba(255,255,255,0.1);
                   border-top-left-radius: 2px; border-top-right-radius: 2px;
                   border-bottom-left-radius: 2px; border-bottom-right-radius: 2px;
                   margin-bottom: 10px; overflow: hidden;">
            <ui:VisualElement name="RelationBarFill"
                style="width: 50%; height: 3px;
                       background-color: rgb(255,215,80);"/>
        </ui:VisualElement>

        <!-- Rând 2: Info chips -->
        <ui:VisualElement style="flex-direction: row; margin-bottom: 10px; flex-wrap: wrap;">
            <ui:Label name="PriceLabel" text="0.00 RON/buc"
                style="color: rgb(255,220,50); font-size: 13px; -unity-font-style: bold;
                       background-color: rgba(255,220,50,0.1);
                       padding-left: 8px; padding-right: 8px;
                       padding-top: 3px; padding-bottom: 3px;
                       border-top-left-radius: 10px; border-top-right-radius: 10px;
                       border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
                       margin-right: 6px;"/>
            <ui:Label name="DeliveryLabel" text="1 zi"
                style="color: rgb(150,200,255); font-size: 12px;
                       background-color: rgba(150,200,255,0.1);
                       padding-left: 8px; padding-right: 8px;
                       padding-top: 3px; padding-bottom: 3px;
                       border-top-left-radius: 10px; border-top-right-radius: 10px;
                       border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
                       margin-right: 6px;"/>
            <ui:Label name="ModifierLabel" text=""
                style="font-size: 12px; display: none;
                       padding-left: 8px; padding-right: 8px;
                       padding-top: 3px; padding-bottom: 3px;
                       border-top-left-radius: 10px; border-top-right-radius: 10px;
                       border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;"/>
        </ui:VisualElement>

        <!-- Datorie -->
        <ui:Label name="DebtLabel" text=""
            style="color: rgb(255,140,60); font-size: 11px;
                   margin-bottom: 6px; white-space: normal; display: none;"/>
        <ui:Button name="PayDebtBtn" text="Achita datoria"
            style="height: 28px; margin-bottom: 6px;
                   background-color: rgba(180,60,30,0.8);
                   color: white; font-size: 12px;
                   border-top-left-radius: 6px; border-top-right-radius: 6px;
                   border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
                   border-width: 0; display: none;"/>

        <!-- Buton selectare -->
        <ui:Button name="SelectSupplierBtn" text="Selecteaza acest furnizor"
            style="height: 36px;
                   background-color: rgba(255,255,255,0.1);
                   color: white; font-size: 13px;
                   border-top-left-radius: 6px; border-top-right-radius: 6px;
                   border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
                   border-width: 1px; border-color: rgba(255,255,255,0.2);"/>
    </ui:VisualElement>
</ui:UXML>
