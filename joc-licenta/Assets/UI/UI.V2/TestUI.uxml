                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="Legend" style="flex-direction: row; justify-content: flex-end; margin-bottom: 5px;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 15px;">
                        <ui:VisualElement style="width: 8px; height: 8px; background-color: rgb(76, 175, 80); border-radius: 4px; margin-right: 4px;"/>
                        <ui:Label text="Venit" style="color: rgb(180, 180, 180); font-size: 10px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement style="width: 8px; height: 8px; background-color: rgb(229, 57, 53); border-radius: 4px; margin-right: 4px;"/>
                        <ui:Label text="Cheltuieli" style="color: rgb(180, 180, 180); font-size: 10px;"/>
                    </ui:VisualElement>
