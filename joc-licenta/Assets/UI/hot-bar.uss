:root {
}

#EmployeePanel > #EmployeeList > #EmployeeTemplateCard > #AssignJob > .unity-enum-field__label {
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-style: bold;
    left: 0;
}

#EmployeePanel > #EmployeeList > #EmployeeTemplateCard > #AssignJob > .unity-enum-field__input {
    left: auto;
    position: relative;
    right: auto;
    width: auto;
    min-width: auto;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

#EmployeePanel > #EmployeeList > #EmployeeTemplateCard > #AssignJob > .unity-enum-field__label {
    right: auto;
    left: auto;
    position: relative;
}

#EmployeePanel > #EmployeeList > #EmployeeTemplateCard > #AssignJob > .unity-enum-field__input > .unity-enum-field__text {
    left: 0%;
    color: rgb(0, 0, 0);
}

#StatsPanel > .unity-tab-view__content-viewport > #unity-tab-view__header-container > #unity-tab__header {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    background-color: rgb(30, 35, 36);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-left-color: rgb(70, 70, 70);
    border-right-color: rgb(70, 70, 70);
    border-top-color: rgb(70, 70, 70);
    border-bottom-color: rgb(70, 70, 70);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 0;
    border-left-width: 2px;
    margin-left: 0;
    margin-right: 2px;
}

#StatsPanel > .unity-tab-view__content-viewport > #unity-tab-view__header-container > #unity-tab__header:checked {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    border-left-color: rgb(182, 182, 182);
    border-right-color: rgb(182, 182, 182);
    border-top-color: rgb(182, 182, 182);
    border-bottom-color: rgb(182, 182, 182);
    border-bottom-width: 0;
}

.has-tooltip {
}

#ObjectInfo > #Content > #ProductDropdown > .unity-popup-field__input {
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-bottom-left-radius: 9px;
    width: 124px;
    min-width: 175px;
    max-width: none;
    left: -93px;
    position: relative;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(226, 226, 226);
    border-right-color: rgb(226, 226, 226);
    border-top-color: rgb(226, 226, 226);
    border-bottom-color: rgb(226, 226, 226);
    background-color: rgb(51, 51, 56);
}

#ObjectInfo > #Content > #ProductDropdown > .unity-popup-field__label {
    min-width: 144px;
    width: 12px;
    align-self: center;
    -unity-font-style: bold;
}


